generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  String    @default("STUDENT")
  grade                 Int       @default(6)
  class                 String?
  language              String    @default("en")
  schoolId              String?
  school                School?   @relation(fields: [schoolId], references: [id])
  xp                    Int       @default(0)
  level                 Int       @default(1)
  streak                Int       @default(0)
  streakDays            Int       @default(0)
  lastLoginDate         DateTime?
  totalDaysActive       Int       @default(0)
  levelsCompleted       Int       @default(0)
  lastActive            DateTime  @default(now())
  badges                String[]  @default([]) // Array of badge IDs
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  userBadges            UserBadge[]
  questProgress         QuestProgress[]
  chapterProgress       ChapterProgress[]
  dailyChallengeCompletion DailyChallengeCompletion[]
  notifications         Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model School {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  district String
  state    String
  users    User[]
}

model Subject {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  icon  String
  color String
  order Int    @default(0)
  units Unit[]
}

model Unit {
  id        String  @id @default(cuid())
  name      String
  grade     Int
  order     Int     @default(0)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quests    Quest[]
  contents  Content[]
}

model Content {
  id          String   @id @default(cuid())
  title       String   // English title (main)
  titleJson   String   @default("{}") // JSON: {en: "...", hi: "..."}
  description String   @default("") // English description (main)
  descJson    String   @default("{}") // JSON: {en: "...", hi: "..."}
  type        String   @default("PDF") // PDF, VIDEO, AUDIO, DOCUMENT, LINK
  fileUrl     String   // path or URL
  fileName    String   @default("")
  fileSize    Int      @default(0)
  language    String   @default("en") // Original upload language
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy   String   // teacher user id
  createdAt   DateTime @default(now())
}

model Quest {
  id         String @id @default(cuid())
  title      String
  type       String @default("QUIZ") // LESSON | QUIZ | BOSS
  difficulty String @default("EASY")
  xpReward   Int    @default(50)
  passMark   Int    @default(70) // Minimum score to pass (0-100)
  timeLimit  Int    @default(300)
  unitId     String
  unit       Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  content    String @default("{}") // JSON string — multilingual question bank
  order      Int    @default(0)
  createdBy  String? // teacher ID if custom
  progress   QuestProgress[]
}

model Chapter {
  id          String @id @default(cuid())
  chapterId   String // e.g., "m1", "p2" (from game.js CURRICULUM)
  title       String
  subject     String // e.g., "math", "physics"
  type        String @default("lesson") // "lesson" | "quiz" | "boss"
  xpReward    Int    @default(50)
  passMark    Int    @default(70)
  icon        String @default("📚")
  order       Int    @default(0)
  content     String @default("{}") // JSON: lesson content or quiz data
  progress    ChapterProgress[]

  @@unique([chapterId, subject])
}

model ChapterProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  status      String   @default("locked") // "locked" | "current" | "done"
  score       Int      @default(0)
  attempts    Int      @default(0)
  timeSpent   Int      @default(0) // milliseconds
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, chapterId])
}

model QuestProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  score       Int
  stars       Int       @default(0)
  xpEarned    Int
  completedAt DateTime  @default(now())
  syncedAt    DateTime?

  @@unique([userId, questId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  icon        String
  trigger     String
  users       UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
}

model DailyChallengeCompletion {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String   // e.g., "dc1", "dc2"
  xpAwarded       Int      @default(0)
  completedDate   DateTime @default(now())

  @@unique([userId, challengeId, completedDate])
}
